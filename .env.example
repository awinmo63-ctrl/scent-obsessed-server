# ============================================================
# Scent Obsessed — Environment Variables
# Copy this file to ".env" and fill in real values.
# NEVER commit the real .env to GitHub.
# ============================================================

# --- Server ---
PORT=5000

# --- Supabase (database + auth) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# --- Cashfree (payments) ---
CASHFREE_APP_ID=your-cashfree-app-id
CASHFREE_SECRET_KEY=your-cashfree-secret-key
CASHFREE_ENVIRONMENT=production

# --- Shiprocket (shipping automation) ---
SHIPROCKET_EMAIL=your-shiprocket-login-email
SHIPROCKET_PASSWORD=your-shiprocket-password
SHIPROCKET_PICKUP_LOCATION=Primary
SHIPROCKET_PICKUP_PINCODE=141002

# --- Gemini (AI concierge chatbot) ---
GEMINI_API_KEY=your-gemini-api-key

# --- Admin panel security ---
# Generate a long random string for JWT_SECRET (e.g. `openssl rand -hex 32`)
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_USERNAME=admin
# Store a bcrypt HASH of the password, not the plaintext password.
# Generate with: node -e "console.log(require('bcryptjs').hashSync('YOUR_PASSWORD',10))"
ADMIN_PASSWORD_HASH=replace-with-bcrypt-hash
